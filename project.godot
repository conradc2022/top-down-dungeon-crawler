; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dungeon Crawler"
run/main_scene="res://Scenes/Dungeon/WorldScene.tscn"
config/features=PackedStringArray("4.3", "C#", "Mobile")
config/icon="res://icon.svg"

[autoload]

SignalBus="*res://Scripts/Singletons/SignalBus.cs"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"

[dialogic]

directories/dch_directory={
"signpost": "res://Assets/Dialogic/Characters/signpost.dch"
}
directories/dtl_directory={
"signpost_demo": "res://Assets/DialogicTimelines/signpost_demo.dtl"
}
glossary/default_case_sensitive=true
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
audio/max_channels=4.0
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
layout/style_list=["res://Assets/Dialogic/Styles/Standard.tres"]
layout/default_style="res://Assets/Dialogic/Styles/Standard.tres"

[dialogue_manager]

general/wrap_lines=true
general/balloon_path="res://Scenes/UI/DialogueBox/Balloon.tscn"
general/uses_dotnet=true
general/states=["SignalBus"]

[display]

window/size/viewport_width=1980
window/size/viewport_height=1020
window/stretch/mode="viewport"

[dotnet]

project/assembly_name="Dungeon Crawler"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")


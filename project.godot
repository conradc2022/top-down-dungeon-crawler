[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Dialog"
2d_physics/layer_3="Entity"
2d_physics/layer_4="Item"
2d_physics/layer_5="Tile"
2d_physics/layer_6="Light"

[rendering]

renderer/rendering_method="mobile"
